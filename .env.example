# ═════════════════════════════════════════════════════════════════════
# SAMS EDUTECH — PRODUCTION ENVIRONMENT VARIABLES (.env.local)
# ═════════════════════════════════════════════════════════════════════

# 1. Supabase Project Credentials (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Alternatively, if your project uses the standard anon key format:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Service Role Key (OPTIONAL — Server-Only, for complete admin bypassing of RLS)
# Keep secret! Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Admin Command Center Access Passkey (Used to log into /admin)
ADMIN_ACCESS_KEY=sams-edutech-admin-2026-secure-key
# (Optional alias: ADMIN_MASTER_KEY=sams-edutech-admin-2026-secure-key)

# 4. Cryptographic Master Secret for AES-256-GCM (Min 32 characters)
ADMIN_SECRET_KEY=sams_master_crypto_secret_32bytes_2026_prod!
# (Optional alias: ENCRYPTION_SECRET=sams_master_crypto_secret_32bytes_2026_prod!)

# 5. Production Environment & Port Settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
