# ═════════════════════════════════════════════════════════════════════
# SAMS EDUTECH — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ═════════════════════════════════════════════════════════════════════
# Copy this file to .env.local on your Hostinger VPS or hPanel environment:
#   cp .env.example .env.local
# ═════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# 1. SUPABASE DATABASE CONFIGURATION (Free Tier Compatible)
# ─────────────────────────────────────────────────────────────────────
# Obtain from your Supabase Dashboard: Project Settings -> API (or API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Public API Key ("public" / "anon" / "publishable" in Supabase dashboard):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Alternatively, if your project uses the standard anon key format:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Secret API Key ("secret" / "service_role" in Supabase dashboard):
# (Server-Only privileged key for admin operations & bypassing RLS. Do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Alternatively, you can name it SUPABASE_SECRET_KEY:
# SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────
# 2. ADMIN PORTAL ACCESS & AUTHENTICATION CREDENTIALS
# ─────────────────────────────────────────────────────────────────────
# Passkey required to authenticate in the faculty command center at /admin
ADMIN_ACCESS_KEY=sams-edutech-admin-2026-secure-key

# Cryptographic Master Secret for AES-256-GCM cipher encryption (Minimum 32 characters)
ADMIN_SECRET_KEY=sams_master_crypto_secret_32bytes_2026_prod!

# ─────────────────────────────────────────────────────────────────────
# 3. NODE.JS RUNTIME & HOSTINGER PRODUCTION SETTINGS
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ─────────────────────────────────────────────────────────────────────
# 4. SITE & DOMAIN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────
# Your live domain URL (Required for Supabase Auth Callback whitelist)
# Example: https://samsedutech.com or https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─────────────────────────────────────────────────────────────────────
# 5. AUTOMATED BANK / MERCHANT UPI WEBHOOK (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────
# If you connect PhonePe Business, Paytm for Business, or BharatPe Merchant:
# Set your webhook URL in their merchant portal to: https://yourdomain.com/api/upi/webhook
# Pass the secret below in webhook header or body:
UPI_WEBHOOK_SECRET=sams_master_crypto_secret_32bytes_2026_prod!
